# Response headers for Cloudflare Pages. Ignored by Apache/LiteSpeed hosts,
# which read .htaccess instead.
#
# Cloudflare appends the headers of every matching rule rather than letting a
# later one replace an earlier one. Two Cache-Control rules matching the same
# file produce one header with two max-age values, and the browser obeys the
# first. So the catch-all below sets no Cache-Control, and each path picks up
# exactly one of the rules that follow.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Asset file names contain a content hash, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The pages themselves must always be revalidated, or visitors keep an old
# index.html that points at assets which no longer exist.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/hi/*
  Cache-Control: public, max-age=0, must-revalidate

# Crawler and install metadata: cheap to refetch, should not go stale for long.
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Icons and the sharing image keep their names across builds, so they get a
# week rather than a year.
/favicon.svg
  Cache-Control: public, max-age=604800

/og-image.jpg
  Cache-Control: public, max-age=604800

/icon-192.png
  Cache-Control: public, max-age=604800

/icon-512.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800
