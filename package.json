{
  "name": "talwar-dental-care",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "build:preview": "vite build --outDir dist-single --emptyOutDir && node scripts/inline-preview.mjs",
    "deploy:cloudflare": "npm run build && rm -rf dist/.vite dist/.DS_Store && npx wrangler@4 pages deploy dist --project-name talwar-dental",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "description": "Bilingual (English/Hindi) website for Talwar Dental Care, Mansarovar, Jaipur",
  "engines": {
    "node": ">=18.18"
  }
}
